{
	"name": "yahtze",
	"displayName": "ZIP/TAR Explorer",
	"description": "Custom editor and explorer for ZIP, TAR, and TGZ archives or folders.",
	"keywords": [
		"zip",
		"tar",
		"tgz",
		"archives",
		"explorer"
	],
	"version": "0.1.0",
	"license": "MIT",
	"icon": "assets/icon.png",
	"publisher": "isopodlabs",
	"repository": "https://github.com/adrianstephens/vscode-explorer",
	"homepage": "https://github.com/adrianstephens/vscode-explorer#readme",
	"bugs": {
		"url": "https://github.com/adrianstephens/vscode-explorer/issues"
	},
	"files": [
		"node_modules/@isopodlabs/binary/dist/*.js",
		"node_modules/@isopodlabs/binary_bitmaps/dist/*.js",
		"node_modules/@isopodlabs/utilities/dist/*.js",
		"node_modules/@isopodlabs/vscode_utils/dist/**/*.js",
		"node_modules/@isopodlabs/vscode_utils/assets",
		"out/**/*.js",
		"assets/explorer.css",
		"assets/bitmap.css",
		"assets/bitmap.vert",
		"assets/bitmap.frag",
		"assets/icon.png",
		"LICENSE.txt"
	],
	"engines": {
		"vscode": "^1.75.0"
	},
	"categories": [
		"Other",
		"Visualization"
	],
	"extensionKind": [
		"workspace"
	],
	"activationEvents": [
		"onFileSystem:zip"
	],
	"main": "./out/src/extension.js",
	"contributes": {
		"customEditors": [
			{
				"viewType": "zip.view",
				"displayName": "ZIP Viewer",
				"priority": "default",
				"selector": [
					{
						"filenamePattern": "*.zip"
					},
					{
						"filenamePattern": "*.jar"
					},
					{
						"filenamePattern": "*.apk"
					},
					{
						"filenamePattern": "*.vsix"
					},
					{
						"filenamePattern": "*.tar"
					},
					{
						"filenamePattern": "*.tgz"
					},
					{
						"filenamePattern": "*.tar.gz"
					}
				]
			},
			{
				"viewType": "bitmap.viewer",
				"displayName": "Bitmap Viewer",
				"priority": "default",
				"selector": [
					{
						"filenamePattern": "*.bmp"
					},
					{
						"filenamePattern": "*.png"
					},
					{
						"filenamePattern": "*.jpg"
					},
					{
						"filenamePattern": "*.jpeg"
					},
					{
						"filenamePattern": "*.dds"
					}
				]
			}
		],
		"commands": [
			{
				"command": "zip.delete",
				"title": "Delete",
				"enablement": "!zip.readonly"
			},
			{
				"command": "zip.rename",
				"title": "Rename...",
				"enablement": "!zip.readonly"
			},
			{
				"command": "zip.explore",
				"title": "Reveal in Editor"
			},
			{
				"command": "bitmap.fit",
				"title": "Fit to Window",
				"icon": "$(screen-normal)"
			},
			{
				"command": "bitmap.reset",
				"title": "Reset Zoom",
				"icon": "$(refresh)"
			}
		],
		"keybindings": [
			{
				"command": "zip.rename",
				"key": "f2",
				"when": "activeCustomEditorId == zip.view && !zip.readonly"
			},
			{
				"command": "zip.delete",
				"key": "delete",
				"when": "activeCustomEditorId == zip.view && !zip.readonly"
			}
		],
		"menus": {
			"webview/context": [
				{
					"command": "zip.rename",
					"when": "webviewId == 'zip.view' && entry"
				},
				{
					"command": "zip.delete",
					"when": "webviewId == 'zip.view' && entry"
				}
			],
			"explorer/context": [
				{
					"command": "zip.explore",
					"when": "explorerResourceIsFolder"
				}
			],
			"editor/title": [
				{
					"command": "bitmap.fit",
					"when": "activeCustomEditorId == bitmap.viewer",
					"group": "navigation"
				},
				{
					"command": "bitmap.reset",
					"when": "activeCustomEditorId == bitmap.viewer",
					"group": "navigation"
				}
			]
		}
	},
	"scripts": {
		"build": "tsc -b",
		"watch": "tsc -b -watch",
		"watch-link": "tsc -b -watch ./tsconfig.link.json",
		"link": "npm link @isopodlabs/binary @isopodlabs/binary_libs @isopodlabs/binary_bitmaps @isopodlabs/utilities @isopodlabs/vscode_utils",
		"update": "npm install @isopodlabs/binary @isopodlabs/binary_libs @isopodlabs/binary_bitmaps @isopodlabs/utilities @isopodlabs/vscode_utils"
	},
	"devDependencies": {
		"@types/node": "^18",
		"@types/vscode": "^1.75.0",
		"typescript": "^5.8.0"
	},
	"dependencies": {
		"@isopodlabs/binary": "^1.9.1",
		"@isopodlabs/binary_libs": "^1.7.0",
		"@isopodlabs/binary_bitmaps": "^1.7.0",
		"@isopodlabs/utilities": "^1.10.0",
		"@isopodlabs/vscode_utils": "^0.6.2"
	}
}
